{
  "name": "unlighthouse",
  "type": "module",
  "version": "1.0.0-beta.1",
  "description": "Delightfully scan your entire website with Google Lighthouse. Navigate your performance, accessibility and SEO.",
  "license": "MIT",
  "homepage": "https://github.com/harlan-zw/unlighthouse#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlan-zw/unlighthouse.git",
    "directory": "packages/unlighthouse"
  },
  "bugs": {
    "url": "https://github.com/harlan-zw/unlighthouse/issues"
  },
  "keywords": [
    "lighthouse",
    "audit",
    "seo",
    "performance",
    "speed"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./types.d.mts",
      "import": "./dist/index.mjs"
    },
    "./cli": "./dist/cli/cli.mjs",
    "./ci": "./dist/cli/ci.mjs",
    "./config": "./config.mjs",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "types": "./types.d.mts",
  "typesVersions": {
    "*": {
      "config": [
        "dist/config"
      ]
    }
  },
  "bin": {
    "unlighthouse": "bin/unlighthouse.mjs",
    "unlighthouse-ci": "bin/unlighthouse-ci.mjs",
    "unlighthouse-mcp": "bin/unlighthouse-mcp.mjs"
  },
  "files": [
    "bin",
    "config.d.mts",
    "config.mjs",
    "dist",
    "types.d.mts",
    "types.d.ts"
  ],
  "engines": {
    "node": ">=24.13.1"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test:attw": "attw --pack --profile esm-only",
    "test:publint": "publint"
  },
  "dependencies": {
    "@unlighthouse/contracts": "workspace:*",
    "@unlighthouse/core": "workspace:*",
    "@unlighthouse/mcp": "workspace:*",
    "better-opn": "catalog:dependencies",
    "tinypool": "catalog:",
    "ws": "catalog:dependencies",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@lhci/utils": "catalog:",
    "@libsql/client": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@puppeteer/browsers": "catalog:dependencies",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "@unlighthouse/lighthouse-runtime": "workspace:*",
    "@unlighthouse/ui": "workspace:*",
    "aws4fetch": "catalog:",
    "c12": "catalog:dependencies",
    "cac": "catalog:dependencies",
    "chrome-launcher": "catalog:dependencies",
    "citty": "catalog:dependencies",
    "consola": "catalog:dependencies",
    "defu": "catalog:dependencies",
    "drizzle-orm": "catalog:dependencies",
    "fflate": "catalog:dependencies",
    "h3": "catalog:dependencies",
    "hookable": "catalog:dependencies",
    "jiti": "catalog:",
    "launch-editor": "catalog:dependencies",
    "lighthouse": "catalog:dependencies",
    "listhen": "catalog:dependencies",
    "puppeteer-core": "catalog:dependencies",
    "ufo": "catalog:dependencies",
    "unstorage": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}
