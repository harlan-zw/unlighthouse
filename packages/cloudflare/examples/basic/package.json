{
  "name": "unlighthouse-cf-example",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24.13.1"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build:panel": "cd ../../../.. && NUXT_PUBLIC_UNLIGHTHOUSE_API_URL=/api NUXT_PUBLIC_UNLIGHTHOUSE_WS_URL= pnpm --filter @unlighthouse/ui build",
    "deploy": "pnpm run build:panel && wrangler deploy",
    "deploy:worker-only": "wrangler deploy",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@unlighthouse/cloudflare": "workspace:*",
    "@unlighthouse/cloudflare-lighthouse": "workspace:*",
    "@unlighthouse/core": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "wrangler": "catalog:"
  }
}
