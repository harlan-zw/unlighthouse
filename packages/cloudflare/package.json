{
  "name": "@unlighthouse/cloudflare",
  "type": "module",
  "version": "0.0.0-v1",
  "private": true,
  "description": "Reusable Cloudflare Workers adapters for Unlighthouse: auditors, D1/R2 storage, Durable Objects, and Workflows.",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./auditors/container": {
      "types": "./dist/auditors/container.d.mts",
      "import": "./dist/auditors/container.mjs"
    },
    "./durable-objects": {
      "types": "./dist/do/index.d.mts",
      "import": "./dist/do/index.mjs"
    },
    "./events": {
      "types": "./dist/scan-events-emit.d.mts",
      "import": "./dist/scan-events-emit.mjs"
    },
    "./seeds": {
      "types": "./dist/seeds/index.d.mts",
      "import": "./dist/seeds/index.mjs"
    },
    "./storage": {
      "types": "./dist/storage/d1-r2.d.mts",
      "import": "./dist/storage/d1-r2.mjs"
    },
    "./workflows/scan": {
      "types": "./dist/workflows/scan.d.mts",
      "import": "./dist/workflows/scan.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.13.1"
  },
  "scripts": {
    "build": "obuild",
    "stub": "obuild --stub",
    "typecheck": "tsc --noEmit",
    "test:attw": "attw --pack --profile esm-only",
    "test:publint": "publint"
  },
  "dependencies": {
    "@cloudflare/containers": "catalog:",
    "@unlighthouse/contracts": "workspace:*",
    "@unlighthouse/core": "workspace:*",
    "drizzle-orm": "catalog:dependencies",
    "h3": "catalog:dependencies"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:"
  }
}
