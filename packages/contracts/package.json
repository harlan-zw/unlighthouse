{
  "name": "@unlighthouse/contracts",
  "type": "module",
  "version": "0.0.0-v1",
  "private": true,
  "description": "Shared types and contracts for Unlighthouse v1.",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./types/atoms": {
      "types": "./dist/types/atoms.d.mts",
      "import": "./dist/types/atoms.mjs"
    },
    "./ports": {
      "types": "./dist/ports/index.d.mts",
      "import": "./dist/ports/index.mjs"
    },
    "./drizzle": {
      "types": "./dist/drizzle/index.d.mts",
      "import": "./dist/drizzle/index.mjs"
    },
    "./config": {
      "types": "./dist/config/index.d.mts",
      "import": "./dist/config/index.mjs"
    },
    "./commands": {
      "types": "./dist/commands/index.d.mts",
      "import": "./dist/commands/index.mjs"
    },
    "./client": {
      "types": "./dist/client/index.d.mts",
      "import": "./dist/client/index.mjs"
    },
    "./packs": {
      "types": "./dist/packs/index.d.mts",
      "import": "./dist/packs/index.mjs"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.mts",
      "import": "./dist/hooks/index.mjs"
    },
    "./logging": {
      "types": "./dist/logging/index.d.mts",
      "import": "./dist/logging/index.mjs"
    },
    "./errors": {
      "types": "./dist/errors/index.d.mts",
      "import": "./dist/errors/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "dist/schemas"
  ],
  "engines": {
    "node": ">=24.13.1"
  },
  "scripts": {
    "build": "tsdown && tsx scripts/emit-schemas.ts",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test:attw": "attw --pack --profile esm-only",
    "test:publint": "publint"
  },
  "peerDependencies": {
    "drizzle-orm": "catalog:dependencies",
    "zod": "catalog:"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  },
  "dependencies": {
    "hookable": "catalog:dependencies"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "chrome-launcher": "catalog:dependencies",
    "lighthouse": "catalog:dependencies",
    "listhen": "catalog:dependencies",
    "puppeteer-core": "catalog:dependencies",
    "ufo": "catalog:dependencies",
    "zod": "catalog:"
  }
}
