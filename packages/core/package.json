{
  "name": "@unlighthouse/core",
  "type": "module",
  "version": "0.0.0-v1",
  "private": true,
  "description": "Pure core modules for Unlighthouse v1 (report, comparison, seeds, policies, crawlers, auditors, storage, api).",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./report": {
      "types": "./dist/report/index.d.mts",
      "import": "./dist/report/index.mjs"
    },
    "./comparison": {
      "types": "./dist/comparison/index.d.mts",
      "import": "./dist/comparison/index.mjs"
    },
    "./seeds": {
      "types": "./dist/seeds/index.d.mts",
      "import": "./dist/seeds/index.mjs"
    },
    "./seeds/route-definitions": {
      "types": "./dist/seeds/route-definitions.d.mts",
      "import": "./dist/seeds/route-definitions.mjs"
    },
    "./crawlers": {
      "types": "./dist/crawlers/index.d.mts",
      "import": "./dist/crawlers/index.mjs"
    },
    "./auditors": {
      "types": "./dist/auditors/index.d.mts",
      "import": "./dist/auditors/index.mjs"
    },
    "./auditors/mock": {
      "types": "./dist/auditors/mock.d.mts",
      "import": "./dist/auditors/mock.mjs"
    },
    "./auditors/cdp-connect": {
      "types": "./dist/auditors/cdp-connect.d.mts",
      "import": "./dist/auditors/cdp-connect.mjs"
    },
    "./auditors/remote-lighthouse": {
      "types": "./dist/auditors/remote-lighthouse.d.mts",
      "import": "./dist/auditors/remote-lighthouse.mjs"
    },
    "./auditors/crux": {
      "types": "./dist/auditors/crux.d.mts",
      "import": "./dist/auditors/crux.mjs"
    },
    "./auditors/dataforseo": {
      "types": "./dist/auditors/dataforseo.d.mts",
      "import": "./dist/auditors/dataforseo.mjs"
    },
    "./auditors/local": {
      "types": "./dist/auditors/local.d.mts",
      "import": "./dist/auditors/local.mjs"
    },
    "./auditors/psi": {
      "types": "./dist/auditors/psi.d.mts",
      "import": "./dist/auditors/psi.mjs"
    },
    "./auditors/route": {
      "types": "./dist/auditors/route/index.d.mts",
      "import": "./dist/auditors/route/index.mjs"
    },
    "./util/path": {
      "types": "./dist/util/path.d.mts",
      "import": "./dist/util/path.mjs"
    },
    "./util/fetch": {
      "types": "./dist/util/fetch.d.mts",
      "import": "./dist/util/fetch.mjs"
    },
    "./util/filter": {
      "types": "./dist/util/filter.d.mts",
      "import": "./dist/util/filter.mjs"
    },
    "./storage": {
      "types": "./dist/storage/index.d.mts",
      "import": "./dist/storage/index.mjs"
    },
    "./storage/drizzle": {
      "types": "./dist/storage/drizzle/index.d.mts",
      "import": "./dist/storage/drizzle/index.mjs"
    },
    "./storage/memory": {
      "types": "./dist/storage/memory/index.d.mts",
      "import": "./dist/storage/memory/index.mjs"
    },
    "./storage/unstorage-blobs": {
      "types": "./dist/storage/unstorage-blobs/index.d.mts",
      "import": "./dist/storage/unstorage-blobs/index.mjs"
    },
    "./api": {
      "types": "./dist/api/index.d.mts",
      "import": "./dist/api/index.mjs"
    },
    "./api/static-client": {
      "types": "./dist/api/static-client.d.mts",
      "import": "./dist/api/static-client.mjs"
    },
    "./api/http": {
      "types": "./dist/api/http.d.mts",
      "import": "./dist/api/http.mjs"
    },
    "./api/handlers": {
      "types": "./dist/api/handlers/index.d.mts",
      "import": "./dist/api/handlers/index.mjs"
    },
    "./api/dashboard": {
      "types": "./dist/api/dashboard.d.mts",
      "import": "./dist/api/dashboard.mjs"
    },
    "./logger": {
      "types": "./dist/logger.d.mts",
      "development": "./src/logger.ts",
      "import": "./dist/logger.mjs"
    },
    "./packs": {
      "types": "./dist/packs/index.d.mts",
      "import": "./dist/packs/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "dist/migrations/sqlite/**",
    "src/logger.ts"
  ],
  "engines": {
    "node": ">=24.13.1"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "test:attw": "attw --pack --profile esm-only",
    "test:publint": "publint"
  },
  "peerDependencies": {
    "better-sqlite3": "catalog:dependencies",
    "drizzle-orm": "catalog:dependencies",
    "unstorage": "catalog:"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "unstorage": {
      "optional": true
    }
  },
  "dependencies": {
    "@unlighthouse/contracts": "workspace:*",
    "chrome-launcher": "catalog:dependencies",
    "consola": "catalog:dependencies",
    "crawlee": "catalog:dependencies",
    "fflate": "catalog:dependencies",
    "h3": "catalog:dependencies",
    "hookable": "catalog:dependencies",
    "lighthouse": "catalog:dependencies",
    "ofetch": "catalog:dependencies",
    "puppeteer-core": "catalog:dependencies",
    "radix3": "catalog:dependencies",
    "tinypool": "catalog:",
    "ufo": "catalog:dependencies",
    "ws": "catalog:dependencies",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "catalog:",
    "better-sqlite3": "catalog:dependencies",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:dependencies",
    "unstorage": "catalog:"
  }
}
