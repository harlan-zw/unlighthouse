{
  "name": "@unlighthouse/mcp",
  "type": "module",
  "version": "1.0.0-beta.0",
  "description": "MCP server preset for Unlighthouse: projects the command registry as MCP tools.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlan-zw/unlighthouse.git",
    "directory": "packages/mcp"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.13.1"
  },
  "scripts": {
    "build": "obuild",
    "stub": "obuild --stub",
    "typecheck": "tsc --noEmit",
    "test:attw": "attw --pack --profile esm-only",
    "test:publint": "publint"
  },
  "dependencies": {
    "@unlighthouse/contracts": "workspace:*",
    "@unlighthouse/core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}
